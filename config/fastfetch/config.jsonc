{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small",
        "padding": {
            "top": 0,
            "right": 2
        },
        "color": {
            "1": "38;2;212;155;66",
            "2": "38;2;228;223;213"
        }
    },
    "display": {
        "separator": " ➜ ",
        "color": {
            "keys": "38;2;212;155;66",
            "title": "38;2;212;155;66"
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "os"
        },
        {
            "type": "kernel",
            "key": "kernel"
        },
        {
            "type": "uptime",
            "key": "uptime"
        },
        {
            "type": "packages",
            "key": "pkgs"
        },
        {
            "type": "shell",
            "key": "shell"
        },
        {
            "type": "wm",
            "key": "wm"
        },
        {
            "type": "terminal",
            "key": "term"
        },
        {
            "type": "cpu",
            "key": "cpu",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "gpu",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "memory"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
